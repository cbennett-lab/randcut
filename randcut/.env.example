# Copy to .env and fill in. .env is gitignored — never commit real keys.
# The same variables go into Railway under Project → Variables.

# ── Sign-in (required on the deployed app) ───────────────────────────────
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# Set the consent screen's User Type to Internal so only GymClass accounts can
# sign in, no Google verification review is needed, and tokens don't expire.
# Authorised redirect URI must exactly match OAUTH_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google sends people back. Local: http://localhost:8000/auth/callback
# Railway: https://<your-app>.up.railway.app/auth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Signs session cookies and encrypts the stored credentials. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out and makes stored credentials unreadable.
SECRET_KEY=

# Only this Google Workspace domain may sign in.
ALLOWED_DOMAIN=gymclassvr.com

# ── Local development ────────────────────────────────────────────────────
# Skips the login gate entirely and reads Drive with the API key below.
# NEVER set this on the deployed app — it makes the URL public.
DEV_NO_AUTH=1

# Drive API key, used only in DEV_NO_AUTH mode (and by the pre-OAuth deploy).
# Needs the content folders shared as "anyone with the link can view".
GOOGLE_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# Buffer personal access token. Normally saved from the Connections panel
# instead; this is just a local shortcut. Buffer has no OAuth for new apps.
BUFFER_ACCESS_TOKEN=

# Where the encrypted credential store lives, and where videos published to
# Buffer are kept. On Railway point this at a mounted volume — a redeploy
# otherwise wipes it, and Buffer would fetch a 404 when a queued post fires.
RANDCUT_STATE_DIR=state

# Origin Buffer fetches post media from. Must be public HTTPS. Defaults to the
# origin of OAUTH_REDIRECT_URI, so normally you don't need to set this.
# PUBLIC_BASE_URL=https://<your-app>.up.railway.app

# Downscale videos to 1080x1920 before handing them to Buffer. Off by default —
# the 4K masters upload fine. Turn on only if Buffer struggles with ~80MB fetches.
# POST_TRANSCODE=1

# Which video types Standard Week doubles up on. Whole folder names, comma
# separated — not substrings, so "My Best Layups and Blocks" stays its own type.
WEEK_PRIORITY=My Best Blocks,My Best Layups

# YouTube category for posted videos. 20 = Gaming, 17 = Sports, 24 = Entertainment.
# YouTube rejects a post without one.
YOUTUBE_CATEGORY_ID=20

# How long published videos stay downloadable after posting. Must comfortably
# outlast the longest gap between queueing a post and Buffer publishing it.
MEDIA_RETENTION_DAYS=30
